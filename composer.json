{
    "name": "nowo-tech/rbac-kit-bundle",
    "description": "Role-based access control for Symfony: a permission catalogue, roles as permission sets checked in their context (global or tenant), a context voter and route / menu coverage tests.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "bundle",
        "rbac",
        "permissions",
        "roles",
        "security",
        "voter",
        "authorization",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/RbacKitBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Maintainer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "support": {
        "issues": "https://github.com/nowo-tech/RbacKitBundle/issues",
        "source": "https://github.com/nowo-tech/RbacKitBundle",
        "docs": "https://github.com/nowo-tech/RbacKitBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/RbacKitBundle/blob/main/docs/CHANGELOG.md"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\RbacKitBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

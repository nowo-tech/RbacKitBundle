<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}RBAC Kit Demo{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { padding-top: 56px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('demo_home') }}">RBAC Kit Bundle Demo</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="{{ path('demo_home') }}">My access</a>
                {% if rbac_can_route('demo_reports') %}
                    <a class="nav-link" href="{{ path('demo_reports') }}" data-testid="demo-nav-reports">Reports</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-link" href="{{ path('nowo_rbac_kit_permission_sets') }}" data-testid="demo-nav-admin">Permission sets</a>
                    <a class="nav-link" href="{{ path('nowo_rbac_kit_catalogue') }}">Catalogue</a>
                {% endif %}
                {% if app.user %}
                    <span class="navbar-text ms-3" data-testid="demo-user">Signed in as {{ app.user.userIdentifier }}</span>
                {% endif %}
            </div>
        </div>
    </nav>

    <main class="container py-4">
        {% block flashes %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
        {% endblock %}
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>

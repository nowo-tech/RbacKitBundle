{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform); it is also the host layout of the RBAC Kit admin pages
    (nowo_ui_kit.layouts.admin). The menu shows only what the signed-in user may open. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _demo_nav = [{label: 'My access', route: 'demo_home'}] %}
{% if rbac_can_route('demo_reports') %}
    {% set _demo_nav = _demo_nav|merge([{label: 'Reports', route: 'demo_reports', section: 'Demo pages', testid: 'demo-nav-reports'}]) %}
{% endif %}
{% if is_granted('ROLE_ADMIN') %}
    {% set _demo_nav = _demo_nav|merge([
        {label: 'Permission sets', route: 'nowo_rbac_kit_permission_sets', active: ['nowo_rbac_kit_permission*'], section: 'RBAC Kit admin', testid: 'demo-nav-admin'},
        {label: 'Catalogue', route: 'nowo_rbac_kit_catalogue', section: 'RBAC Kit admin'},
    ]) %}
{% endif %}
{% set nowo_ui_demo_platform = {
    bundle: 'RBAC Kit',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/RbacKitBundle',
    translation_domain: false,
    locales: [],
    nav: _demo_nav,
} %}

{% block nowo_ui_document_title %}{% block title %}RBAC Kit Demo{% endblock %}{% endblock %}

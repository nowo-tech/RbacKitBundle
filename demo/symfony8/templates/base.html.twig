{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). It is also the host layout of the RBAC Kit admin pages
    (nowo_ui_kit.layouts.admin). The header menu shows only what the signed-in user may open. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}RBAC Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route')|default('') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">RBAC Kit Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' %} aria-current="page"{% endif %}>My access</a>
            {% if rbac_can_route('demo_reports') %}
                <a class="nowo-ui-link" href="{{ path('demo_reports') }}" data-testid="demo-nav-reports"{% if _route == 'demo_reports' %} aria-current="page"{% endif %}>Reports</a>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                <a class="nowo-ui-link" href="{{ path('nowo_rbac_kit_permission_sets') }}" data-testid="demo-nav-admin"{% if _route starts with 'nowo_rbac_kit_permission' %} aria-current="page"{% endif %}>Permission sets</a>
                <a class="nowo-ui-link" href="{{ path('nowo_rbac_kit_catalogue') }}"{% if _route == 'nowo_rbac_kit_catalogue' %} aria-current="page"{% endif %}>Catalogue</a>
            {% endif %}
        </nav>
        {% if app.user %}
            <span class="nowo-ui-muted" data-testid="demo-user">Signed in as {{ app.user.userIdentifier }}</span>
        {% endif %}
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

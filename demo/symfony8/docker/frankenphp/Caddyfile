{
	order mercure after encode
	skip_install_trust
}

# Worker mode: app boots once, handles requests in memory.
# The RbacKit memo services implement ResetInterface (kernel.reset between requests): safe for worker mode.
:80 {
	root * /app/public
	encode zstd br gzip
	mercure {
		anonymous
	}

	php_server {
		hot_reload
		worker {
			file /app/public/index.php
			watch
		}
	}
}
